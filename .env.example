GROQ_API_KEY=your_groq_api_key_here
FLASK_SECRET_KEY=your_random_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Default account created on first run (if no users exist)
DEFAULT_USER_EMAIL=admin@careerai.local
DEFAULT_USER_PASSWORD=admin123

# Optional: override default Groq model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# Set to true to test the full UI without Groq API credits
DEMO_MODE=true

# --- Feature flags (all default to false) ---
# Store users + history in a SQL database instead of JSON files
USE_DATABASE=false
# Use embedding similarity for RAG retrieval instead of TF-IDF
USE_EMBEDDINGS=false
# Run long LLM routes (coach, cover letter, email) as background jobs (HTTP 202 + /jobs/<id>)
USE_ASYNC_JOBS=false

# --- Database ---
# Default: SQLite at backend/data/career_ai.db. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/career_ai

# --- Embeddings ---
# EMBEDDING_PROVIDER=hashing          # hashing (offline) | api
# EMBEDDING_DIM=256
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# --- Async jobs ---
# JOB_BACKEND=memory                  # memory (thread pool) | redis (RQ worker)
# ASYNC_JOB_WORKERS=2
# REDIS_URL=redis://localhost:6379/0
